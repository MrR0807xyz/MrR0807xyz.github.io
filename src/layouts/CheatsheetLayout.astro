---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description?: string;
  headings: { depth: number; slug: string; text: string }[];
  tags?: string[];
}

const { title, description, headings = [], tags = [] } = Astro.props;

const breadcrumbs = [
  { label: 'CHEATSHEETS', href: '/cheatsheet' },
  { label: title },
];

const filteredHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

<BaseLayout title={title} description={description}>
  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 w-full max-w-7xl mx-auto">
    <!-- Main Column -->
    <article class="xl:col-span-8 w-full min-w-0">
      <Breadcrumb items={breadcrumbs} />

      <header class="mb-6 sm:mb-8 pb-6 border-b border-[#2c2d2d]">
        <div class="flex items-center gap-2 mb-3">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase bg-cyber-accent/20 text-cyber-accent border border-cyber-accent/40" data-i18n="cheatsheetBadge">
            OFFENSIVE SECURITY CHEATSHEET
          </span>
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight mb-3 font-sans break-words">
          {title}
        </h1>
        {description && (
          <p class="text-xs sm:text-sm text-[#afb0b1] font-sans leading-relaxed">
            {description}
          </p>
        )}
      </header>

      <!-- Mobile Collapsible Table of Contents -->
      {filteredHeadings.length > 0 && (
        <details class="xl:hidden bg-[#1e1e1e] border border-[#2c2d2d] rounded-xl p-4 mb-8 group">
          <summary class="text-xs font-mono font-bold uppercase tracking-wider text-[#868686] cursor-pointer flex items-center justify-between select-none">
            <span class="flex items-center gap-2 text-white">
              <svg class="w-4 h-4 text-cyber-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
              <span data-i18n="tableOfContents">Table of Contents</span> ({filteredHeadings.length})
            </span>
            <span class="text-[#868686] group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <ul class="mt-3 pt-3 border-t border-[#2c2d2d]/60 space-y-2 text-xs font-sans">
            {filteredHeadings.map((h) => (
              <li class={h.depth === 1 ? 'font-semibold text-white' : h.depth === 2 ? 'pl-3 text-[#afb0b1]' : 'pl-6 text-[#868686] text-[11px]'}>
                <a href={`#${h.slug}`} class="hover:text-cyber-accent transition-colors block py-0.5">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <!-- Prose Content -->
      <div class="prose-cyber w-full">
        <slot />
      </div>

      <!-- Cheatsheet Tags Footer -->
      {tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-[#2c2d2d]">
          <div class="flex items-center gap-2 mb-3 text-xs font-mono text-[#868686] uppercase">
            <svg class="w-4 h-4 text-cyber-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
            <span data-i18n="topicsLabel">Topics:</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="px-3 py-1 rounded-lg text-xs font-mono bg-[#1e1e1e] border border-[#2c2d2d] text-[#afb0b1]">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <div class="mt-8 pt-4 border-t border-[#2c2d2d]/60 flex items-center justify-between text-xs font-mono text-[#868686]">
        <a href="/cheatsheet" class="hover:text-cyber-cyan flex items-center gap-1.5 transition-colors" data-i18n="backToAllCheatsheets">
          ← Back to All Cheatsheets
        </a>
        <button
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="hover:text-cyber-accent flex items-center gap-1.5 transition-colors"
          data-i18n="backToTop"
        >
          Back to Top ↑
        </button>
      </div>
    </article>

    <!-- Desktop Table of Contents Sidebar -->
    <aside class="hidden xl:block xl:col-span-4 w-full">
      <div class="sticky top-20">
        <Toc headings={filteredHeadings} />
      </div>
    </aside>
  </div>
</BaseLayout>
