---
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: string;
  author?: string;
  categories?: string[];
  tags?: string[];
  headings: { depth: number; slug: string; text: string }[];
  image?: string;
  bounty?: string;
  cve?: string;
  cvss?: string;
  severity?: string;
}

const {
  title,
  description,
  pubDate,
  author = 'MrR0807',
  categories = [],
  tags = [],
  headings = [],
  image,
  bounty,
  cve,
  cvss,
  severity,
} = Astro.props;

const breadcrumbs = [
  { label: categories[0] || 'WRITEUPS', href: `/categories/${(categories[0] || 'ctf').toLowerCase()}` },
  { label: title },
];

const getSeverityBadge = (sev: string) => {
  const s = sev?.toLowerCase();
  if (s === 'critical') return 'bg-red-500/20 text-red-400 border-red-500/40';
  if (s === 'high') return 'bg-orange-500/20 text-orange-400 border-orange-500/40';
  if (s === 'medium') return 'bg-amber-500/20 text-amber-400 border-amber-500/40';
  if (s === 'low') return 'bg-blue-500/20 text-blue-400 border-blue-500/40';
  return 'bg-cyan-500/20 text-cyan-400 border-cyan-500/40';
};

const filteredHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

<BaseLayout title={title} description={description} image={image} type="article">
  <div class="flex flex-col xl:flex-row gap-8 xl:gap-12 items-start justify-between w-full">
    <!-- Article Main Column -->
    <article class="flex-1 w-full min-w-0 max-w-4xl overflow-hidden">
      <!-- Breadcrumb -->
      <Breadcrumb items={breadcrumbs} />

      <!-- Post Header -->
      <header class="mb-6 sm:mb-8 pb-6 border-b border-[#2c2d2d]">
        <!-- Badges Bar -->
        <div class="flex flex-wrap items-center gap-2 mb-3">
          {categories.map((cat) => (
            <a
              href={`/categories/${cat.toLowerCase()}`}
              class="px-2.5 py-0.5 rounded-full text-xs font-mono font-medium tracking-wide uppercase bg-[#1e1e1e] border border-[#2c2d2d] text-cyber-cyan hover:border-cyber-cyan transition-colors"
            >
              {cat}
            </a>
          ))}

          {severity && (
            <span class={`px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase border ${getSeverityBadge(severity)}`}>
              {severity}
            </span>
          )}

          {bounty && (
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase bg-amber-500/20 text-amber-300 border border-amber-500/40">
              💰 Bounty: {bounty}
            </span>
          )}

          {cve && (
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase bg-purple-500/20 text-purple-300 border border-purple-500/40">
              🛡️ {cve} {cvss ? `(CVSS ${cvss})` : ''}
            </span>
          )}
        </div>

        <!-- Post Title -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4 font-sans break-words">
          {title}
        </h1>

        <!-- Post Meta Line -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs font-mono text-[#868686]">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-cyber-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            {pubDate}
          </span>
          <span>•</span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-cyber-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            {author}
          </span>
          <span>•</span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span data-i18n="securityResearchBadge">Security Research</span>
          </span>
        </div>

        <!-- Post Banner Image (if available) -->
        {image && (
          <div class="mt-6 rounded-xl overflow-hidden border border-[#2c2d2d] shadow-lg max-h-96">
            <img src={image} alt={title} class="w-full h-full object-cover" />
          </div>
        )}
      </header>

      <!-- Mobile / Tablet Collapsible Table of Contents -->
      {filteredHeadings.length > 0 && (
        <details class="xl:hidden bg-[#1e1e1e] border border-[#2c2d2d] rounded-xl p-4 mb-8 group">
          <summary class="text-xs font-mono font-bold uppercase tracking-wider text-[#868686] cursor-pointer flex items-center justify-between select-none">
            <span class="flex items-center gap-2 text-white">
              <svg class="w-4 h-4 text-cyber-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
              <span data-i18n="tableOfContents">Table of Contents</span> ({filteredHeadings.length})
            </span>
            <span class="text-[#868686] group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <ul class="mt-3 pt-3 border-t border-[#2c2d2d]/60 space-y-2 text-xs font-sans">
            {filteredHeadings.map((h) => (
              <li class={h.depth === 1 ? 'font-semibold text-white' : h.depth === 2 ? 'pl-3 text-[#afb0b1]' : 'pl-6 text-[#868686] text-[11px]'}>
                <a href={`#${h.slug}`} class="hover:text-cyber-accent transition-colors block py-0.5">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <!-- Markdown Prose Content -->
      <div class="prose-cyber w-full">
        <slot />
      </div>

      <!-- Post Tail: Tags, Share & License -->
      <div class="mt-12 pt-6 border-t border-[#2c2d2d] space-y-6">
        <!-- Tags -->
        {tags.length > 0 && (
          <div>
            <div class="flex items-center gap-2 mb-2 text-xs font-mono text-[#868686] uppercase">
              <svg class="w-4 h-4 text-cyber-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
              <span data-i18n="tagsLabel">Tags:</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <a
                  href={`/tags/${tag}`}
                  class="px-3 py-1 rounded-lg text-xs font-mono bg-[#1e1e1e] border border-[#2c2d2d] text-[#afb0b1] hover:text-cyber-accent hover:border-cyber-accent/50 transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Responsible Disclosure Notice -->
        <div class="bg-[#1e1e1e] border border-[#2c2d2d] rounded-xl p-4 text-xs font-sans text-[#868686] leading-relaxed">
          <p class="font-mono text-white font-bold mb-1 flex items-center gap-2">
            <svg class="w-4 h-4 text-cyber-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span>{author} • </span><span data-i18n="responsibleNoticeTitle">Responsible Disclosure Notice</span>
          </p>
          <span data-i18n="responsibleNoticeText">This technical article is published for defensive research and educational purposes. All vulnerabilities discussed here have been properly reported and patched by the respective vendors.</span>
        </div>

        <!-- Footer Navigation -->
        <div class="pt-4 border-t border-[#2c2d2d]/60 flex items-center justify-between text-xs font-mono text-[#868686]">
          <a href="/" class="hover:text-cyber-cyan flex items-center gap-1.5 transition-colors" data-i18n="backToAllWriteups">
            ← Back to All Writeups
          </a>
          <button
            onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
            class="hover:text-cyber-accent flex items-center gap-1.5 transition-colors"
            data-i18n="backToTop"
          >
            Back to Top ↑
          </button>
        </div>
      </div>
    </article>

    <!-- Floating Sticky Table of Contents (Desktop) -->
    <Toc headings={headings} />
  </div>
</BaseLayout>
