---
import Sidebar from '../components/Sidebar.astro';
import SearchModal from '../components/SearchModal.astro';
import LanguageSelector from '../components/LanguageSelector.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE_CONFIG } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  image = SITE_CONFIG.avatar,
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://mrr0807.github.io');
const fullTitle = title === SITE_CONFIG.title ? title : `${title} | ${SITE_CONFIG.title}`;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Initialization to prevent Flash of Unstyled Content (FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('site_theme')) {
          return localStorage.getItem('site_theme');
        }
        if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          return 'light';
        }
        return 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
      }
    </script>

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_CONFIG.author} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- RSS Auto-discovery -->
    <link rel="alternate" type="application/rss+xml" title={SITE_CONFIG.title} href="/rss.xml" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+Pro:ital,wght@0,400;0,600;0,700;0,900;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-cyber-bg text-cyber-text min-h-screen antialiased flex flex-col lg:flex-row font-sans">
    <!-- Left Sidebar (Desktop + Mobile Drawer) -->
    <Sidebar />

    <!-- Mobile Top Navigation Header -->
    <header class="lg:hidden bg-cyber-sidebar border-b border-cyber-border px-3 sm:px-4 py-2.5 flex items-center justify-between sticky top-0 z-30 shadow-md">
      <!-- Left Brand & Menu -->
      <div class="flex items-center gap-2.5 shrink-0">
        <button
          id="open-drawer-btn"
          data-open-drawer
          class="p-2 text-cyber-muted hover:text-white bg-cyber-card rounded-lg border border-cyber-border focus:outline-none focus:ring-1 focus:ring-cyber-accent shrink-0 cursor-pointer"
          aria-label="Open navigation menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <a href="/" class="flex items-center gap-2 shrink-0" title={SITE_CONFIG.author}>
          <div class="w-8 h-8 rounded-full overflow-hidden border border-cyber-accent/80 shrink-0">
            <img src={SITE_CONFIG.avatar} alt={SITE_CONFIG.author} class="w-full h-full object-cover" />
          </div>
          <span class="font-bold text-white font-mono tracking-tight text-xs sm:text-sm whitespace-nowrap">
            @{SITE_CONFIG.handle}
          </span>
        </a>
      </div>

      <!-- Right Action Controls (Theme & Language) -->
      <div class="flex items-center gap-2 shrink-0">
        <ThemeToggle />
        <LanguageSelector />
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="flex-1 lg:ml-72 flex flex-col min-h-screen w-full min-w-0 overflow-x-hidden">
      <!-- Desktop Top Search Bar -->
      <div class="hidden lg:flex items-center justify-between px-8 py-4 border-b border-cyber-border/40 bg-cyber-bg/80 backdrop-blur sticky top-0 z-20">
        <div class="flex items-center gap-3 text-xs font-mono text-cyber-muted">
          <span class="text-cyber-accent flex items-center gap-2 font-bold bg-cyber-accent/10 px-2.5 py-1 rounded border border-cyber-accent/30">
            <span class="w-2 h-2 rounded-full bg-cyber-accent animate-pulse"></span>
            <span data-i18n="securityLabOnline">SECURITY LAB ONLINE</span>
          </span>
          <span class="text-cyber-muted/60">•</span>
          <span class="text-[11px] font-mono text-cyber-muted" data-i18n="securityDomain">OFFENSIVE SECURITY & BUG BOUNTY</span>
        </div>
        
        <div class="flex items-center gap-3">
          <ThemeToggle />
          <LanguageSelector />
          <button
            data-open-search
            class="flex items-center gap-3 px-4 py-2 rounded-lg bg-cyber-card border border-cyber-border text-xs text-cyber-muted hover:text-white hover:border-cyber-muted transition-all shadow-sm"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span data-i18n="searchPlaceholder">Search posts, CVEs, tools...</span>
            <kbd class="bg-cyber-bg px-1.5 py-0.5 rounded border border-cyber-border/80 font-mono text-[10px] text-cyber-accent">Ctrl+K</kbd>
          </button>
        </div>
      </div>

      <!-- Main Slot Content -->
      <main class="flex-1 p-3 sm:p-6 md:p-8 lg:p-10 max-w-7xl w-full mx-auto overflow-x-hidden">
        <slot />
      </main>

      <!-- Global Footer -->
      <footer class="border-t border-cyber-border/40 py-6 px-4 sm:px-8 text-center text-xs text-cyber-muted font-mono bg-cyber-sidebar/40">
        <p>© {new Date().getFullYear()} {SITE_CONFIG.author} ({SITE_CONFIG.handle})</p>
        <p class="mt-1 text-[11px] text-cyber-muted/60">
          All vulnerability reports and writeups are published under responsible disclosure guidelines.
        </p>
      </footer>
    </div>

    <!-- Search Modal Component -->
    <SearchModal />

    <!-- Google Translate Live Translation Engine -->
    <div id="google_translate_element" class="hidden"></div>
    <script is:inline>
      function googleTranslateElementInit() {
        new google.translate.TranslateElement({
          pageLanguage: 'en',
          includedLanguages: 'en,ha,pcm',
          autoDisplay: false
        }, 'google_translate_element');
      }
    </script>
    <script is:inline src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <!-- Interactive Copy Code Script -->
    <script>
      function setupCopyButtons() {
        document.querySelectorAll('pre').forEach((pre) => {
          if (pre.querySelector('.copy-code-btn')) return;

          const button = document.createElement('button');
          button.className = 'copy-code-btn absolute top-2.5 right-2.5 bg-cyber-card/90 hover:bg-cyber-border text-cyber-muted hover:text-white text-xs font-mono px-2 py-1 rounded border border-cyber-border transition-all flex items-center gap-1 opacity-90 lg:opacity-0 lg:group-hover:opacity-100 shadow';
          button.innerHTML = `
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span>Copy</span>
          `;

          pre.classList.add('group', 'relative');
          pre.appendChild(button);

          button.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.innerText || pre.innerText;
            try {
              await navigator.clipboard.writeText(code);
              button.innerHTML = `
                <svg class="w-3.5 h-3.5 text-cyber-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-cyber-accent">Copied!</span>
              `;
              setTimeout(() => {
                button.innerHTML = `
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                  <span>Copy</span>
                `;
              }, 2000);
            } catch (err) {
              console.error('Failed to copy text: ', err);
            }
          });
        });
      }

      document.addEventListener('DOMContentLoaded', setupCopyButtons);
      setupCopyButtons();
    </script>
  </body>
</html>
