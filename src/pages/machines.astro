---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import machinesData from '../data/machines.json';
---

<BaseLayout title="Machines Matrix & Target Search">
  <div class="max-w-6xl mx-auto space-y-6 w-full">
    <Breadcrumb items={[{ label: 'MACHINES' }]} />

    <!-- Header -->
    <header class="pb-6 border-b border-cyber-border">
      <div class="flex items-center gap-3 mb-2">
        <span class="w-3 h-3 rounded-full bg-cyber-cyan animate-pulse"></span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-mono tracking-tight" data-i18n="matrixTitle">
          Target & Machine Matrix
        </h1>
      </div>
      <p class="text-xs font-mono text-cyber-muted max-w-2xl" data-i18n="matrixSubtitle">
        Interactive search matrix of all completed target machines, CTF challenges, and vulnerability research labs with tested skills and writeup links.
      </p>
    </header>

    <!-- Filter Control Bar -->
    <div class="bg-cyber-card border border-cyber-border rounded-xl p-4 sm:p-6 shadow-sm space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <!-- Search Input -->
        <div class="space-y-1">
          <label class="text-[11px] font-mono uppercase text-cyber-muted font-bold" data-i18n="searchMachineLabel">Search Machine / Skill</label>
          <input
            type="text"
            id="matrix-search"
            data-i18n-placeholder="searchMachinePlaceholder"
            placeholder="e.g. Codify, ADCS, RCE..."
            class="w-full bg-cyber-bg border border-cyber-border rounded-lg px-3 py-2 text-xs text-white placeholder-cyber-muted focus:outline-none focus:border-cyber-accent font-mono"
          />
        </div>

        <!-- Platform Filter -->
        <div class="space-y-1">
          <label class="text-[11px] font-mono uppercase text-cyber-muted font-bold" data-i18n="platformLabel">Platform</label>
          <select
            id="matrix-platform"
            class="w-full bg-cyber-bg border border-cyber-border rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyber-accent font-mono cursor-pointer"
          >
            <option value="all" data-i18n="allPlatforms">All Platforms</option>
            <option value="hackthebox">HackTheBox</option>
            <option value="tryhackme">TryHackMe</option>
            <option value="vulnhub">VulnHub / Other</option>
          </select>
        </div>

        <!-- OS Filter -->
        <div class="space-y-1">
          <label class="text-[11px] font-mono uppercase text-cyber-muted font-bold" data-i18n="osLabel">Operating System</label>
          <select
            id="matrix-os"
            class="w-full bg-cyber-bg border border-cyber-border rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyber-accent font-mono cursor-pointer"
          >
            <option value="all" data-i18n="allOS">All OS</option>
            <option value="linux">Linux</option>
            <option value="windows">Windows</option>
          </select>
        </div>

        <!-- Difficulty Filter -->
        <div class="space-y-1">
          <label class="text-[11px] font-mono uppercase text-cyber-muted font-bold" data-i18n="difficultyLabel">Difficulty</label>
          <select
            id="matrix-difficulty"
            class="w-full bg-cyber-bg border border-cyber-border rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyber-accent font-mono cursor-pointer"
          >
            <option value="all" data-i18n="allDifficulties">All Difficulties</option>
            <option value="easy">Easy</option>
            <option value="medium">Medium</option>
            <option value="hard">Hard</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Matrix Table (Desktop & Tablet) -->
    <div class="hidden sm:block bg-cyber-card border border-cyber-border rounded-xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="matrix-table">
          <thead>
            <tr class="bg-cyber-sidebar border-b border-cyber-border text-xs font-mono font-bold text-cyber-muted uppercase">
              <th class="py-3.5 px-4 sm:px-6" data-i18n="colName">Machine Name</th>
              <th class="py-3.5 px-4" data-i18n="colPlatform">Platform</th>
              <th class="py-3.5 px-4" data-i18n="colOS">OS</th>
              <th class="py-3.5 px-4" data-i18n="colDifficulty">Difficulty</th>
              <th class="py-3.5 px-4" data-i18n="colSkills">Skills & Exploits</th>
              <th class="py-3.5 px-4 text-right" data-i18n="colWriteup">Writeup</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-cyber-border/60 text-xs font-mono" id="matrix-tbody">
            {machinesData.map((m) => (
              <tr
                class="matrix-row hover:bg-cyber-cardHover/70 transition-colors"
                data-name={m.name.toLowerCase()}
                data-platform={m.platform.toLowerCase()}
                data-os={m.os.toLowerCase()}
                data-diff={m.difficulty.toLowerCase()}
                data-skills={m.skills.toLowerCase()}
              >
                <td class="py-3.5 px-4 sm:px-6 font-bold text-white">
                  {m.name}
                </td>
                <td class="py-3.5 px-4">
                  <span class={`px-2 py-0.5 rounded border text-[11px] ${
                    m.platform.includes('HackTheBox') ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' :
                    m.platform.includes('TryHackMe') ? 'bg-red-500/10 text-red-400 border-red-500/30' :
                    'bg-cyan-500/10 text-cyan-400 border-cyan-500/30'
                  }`}>
                    {m.platform}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-cyber-text">
                  {m.os === 'Linux' ? '🐧 Linux' : m.os === 'Windows' ? '🪟 Windows' : m.os}
                </td>
                <td class="py-3.5 px-4">
                  <span class={`px-2 py-0.5 rounded text-[11px] font-bold ${
                    m.difficulty.toLowerCase().includes('easy') ? 'text-green-400 bg-green-500/10' :
                    m.difficulty.toLowerCase().includes('medium') ? 'text-amber-400 bg-amber-500/10' :
                    'text-red-400 bg-red-500/10'
                  }`}>
                    {m.difficulty}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-cyber-muted font-sans text-xs max-w-xs truncate">
                  {m.skills}
                </td>
                <td class="py-3.5 px-4 text-right">
                  {m.writeupUrl ? (
                    <a
                      href={m.writeupUrl}
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-cyber-bg hover:bg-cyber-accent hover:text-black border border-cyber-border hover:border-cyber-accent text-cyber-accent text-[11px] font-mono font-bold transition-all"
                    >
                      Read →
                    </a>
                  ) : (
                    <span class="text-cyber-muted/50 text-[11px]">WIP</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile Cards View -->
    <div class="sm:hidden space-y-3" id="matrix-mobile-cards">
      {machinesData.map((m) => (
        <div
          class="matrix-mobile-card bg-cyber-card border border-cyber-border rounded-xl p-4 space-y-3"
          data-name={m.name.toLowerCase()}
          data-platform={m.platform.toLowerCase()}
          data-os={m.os.toLowerCase()}
          data-diff={m.difficulty.toLowerCase()}
          data-skills={m.skills.toLowerCase()}
        >
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-white font-mono text-base">{m.name}</h3>
            <span class={`px-2 py-0.5 rounded text-[11px] font-bold ${
              m.difficulty.toLowerCase().includes('easy') ? 'text-green-400 bg-green-500/10' :
              m.difficulty.toLowerCase().includes('medium') ? 'text-amber-400 bg-amber-500/10' :
              'text-red-400 bg-red-500/10'
            }`}>
              {m.difficulty}
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
            <span class="px-2 py-0.5 rounded bg-cyber-bg border border-cyber-border text-cyber-muted">
              {m.os === 'Linux' ? '🐧 Linux' : m.os === 'Windows' ? '🪟 Windows' : m.os}
            </span>
            <span class={`px-2 py-0.5 rounded border text-[11px] ${
              m.platform.includes('HackTheBox') ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' :
              m.platform.includes('TryHackMe') ? 'bg-red-500/10 text-red-400 border-red-500/30' :
              'bg-cyan-500/10 text-cyan-400 border-cyan-500/30'
            }`}>
              {m.platform}
            </span>
          </div>

          {m.skills && (
            <p class="text-xs text-cyber-muted leading-relaxed font-sans">
              <span class="text-cyber-accent font-mono text-[10px] uppercase block">Skills:</span>
              {m.skills}
            </p>
          )}

          {m.writeupUrl && (
            <div class="pt-2 border-t border-cyber-border/40 flex justify-end">
              <a
                href={m.writeupUrl}
                class="inline-flex items-center gap-1 px-3 py-1 rounded bg-cyber-bg hover:bg-cyber-accent hover:text-black border border-cyber-border text-cyber-accent text-xs font-mono font-bold transition-all"
              >
                Read Writeup →
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('matrix-search') as HTMLInputElement;
  const platformSelect = document.getElementById('matrix-platform') as HTMLSelectElement;
  const osSelect = document.getElementById('matrix-os') as HTMLSelectElement;
  const diffSelect = document.getElementById('matrix-difficulty') as HTMLSelectElement;
  const rows = document.querySelectorAll('.matrix-row') as NodeListOf<HTMLTableRowElement>;
  const mobileCards = document.querySelectorAll('.matrix-mobile-card') as NodeListOf<HTMLDivElement>;

  function filterMatrix() {
    const q = searchInput?.value.toLowerCase().trim() || '';
    const platform = platformSelect?.value.toLowerCase() || 'all';
    const os = osSelect?.value.toLowerCase() || 'all';
    const diff = diffSelect?.value.toLowerCase() || 'all';

    function checkMatch(el: Element) {
      const name = el.getAttribute('data-name') || '';
      const p = el.getAttribute('data-platform') || '';
      const o = el.getAttribute('data-os') || '';
      const d = el.getAttribute('data-diff') || '';
      const s = el.getAttribute('data-skills') || '';

      const matchesSearch = !q || name.includes(q) || s.includes(q);
      const matchesPlatform = platform === 'all' || p.includes(platform);
      const matchesOs = os === 'all' || o.includes(os);
      const matchesDiff = diff === 'all' || d.includes(diff);

      return matchesSearch && matchesPlatform && matchesOs && matchesDiff;
    }

    rows.forEach((row) => {
      row.style.display = checkMatch(row) ? '' : 'none';
    });

    mobileCards.forEach((card) => {
      card.style.display = checkMatch(card) ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', filterMatrix);
  platformSelect?.addEventListener('change', filterMatrix);
  osSelect?.addEventListener('change', filterMatrix);
  diffSelect?.addEventListener('change', filterMatrix);
</script>
