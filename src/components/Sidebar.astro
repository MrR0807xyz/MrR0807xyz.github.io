---
import { SITE_CONFIG } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { label: 'HOME', href: '/', icon: 'home', i18nKey: 'home' },
  { label: 'CATEGORIES', href: '/categories', icon: 'categories', i18nKey: 'categories' },
  { label: 'MACHINES', href: '/machines', icon: 'server', i18nKey: 'machines' },
  { label: 'ALL POSTS', href: '/all-posts', icon: 'archive', i18nKey: 'allPosts' },
  { label: 'CHEATSHEETS', href: '/cheatsheet', icon: 'terminal', i18nKey: 'cheatsheets' },
  { label: 'ABOUT', href: '/about', icon: 'user', i18nKey: 'about' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname.startsWith(href);
};
---

<!-- Desktop Sidebar -->
<aside class="hidden lg:flex lg:w-72 lg:fixed lg:inset-y-0 lg:left-0 bg-cyber-sidebar border-r border-cyber-border z-30 flex-col justify-between p-6 transition-all">
  <div class="overflow-y-auto">
    <!-- Profile & Avatar Section -->
    <div class="flex flex-col items-center text-center pb-6 border-b border-cyber-border/60">
      <a href="/" class="group relative block mb-3">
        <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-cyber-accent/60 group-hover:border-cyber-accent group-hover:shadow-[0_0_20px_rgba(0,220,130,0.3)] transition-all">
          <img 
            src={SITE_CONFIG.avatar} 
            alt={SITE_CONFIG.author} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        </div>
      </a>
      <h1 class="text-base font-bold tracking-tight text-white mb-1 font-sans whitespace-nowrap hover:text-cyber-accent transition-colors">
        <a href="/">{SITE_CONFIG.author}</a>
      </h1>
      <span class="text-xs font-mono text-cyber-accent font-semibold px-2.5 py-0.5 rounded-md bg-cyber-accent/10 border border-cyber-accent/30 inline-block mb-2">
        @{SITE_CONFIG.handle}
      </span>
      <p class="text-xs text-cyber-muted italic leading-relaxed px-2">
        {SITE_CONFIG.tagline}
      </p>
    </div>

    <!-- Navigation Menu -->
    <nav class="mt-6 space-y-1.5">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-semibold tracking-wider transition-all duration-200 ${
            isActive(item.href)
              ? 'bg-cyber-accent/10 text-cyber-accent border-l-4 border-cyber-accent font-bold shadow-sm'
              : 'text-cyber-muted hover:text-white hover:bg-cyber-card'
          }`}
        >
          {item.icon === 'home' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          )}
          {item.icon === 'categories' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          )}
          {item.icon === 'server' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
          )}
          {item.icon === 'archive' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          )}
          {item.icon === 'terminal' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          )}
          {item.icon === 'user' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          )}
          <span data-i18n={item.i18nKey}>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>

  <!-- Social Links & Footer -->
  <div class="pt-6 border-t border-cyber-border/60">
    <div class="flex items-center justify-center gap-2.5 text-cyber-muted">
      {SITE_CONFIG.socials.github && (
        <a href={SITE_CONFIG.socials.github} target="_blank" rel="noopener noreferrer" class="p-2 hover:text-cyber-accent hover:bg-cyber-card rounded-lg transition-colors" title="GitHub">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
      )}
      {SITE_CONFIG.socials.twitter && (
        <a href={SITE_CONFIG.socials.twitter} target="_blank" rel="noopener noreferrer" class="p-2 hover:text-cyber-cyan hover:bg-cyber-card rounded-lg transition-colors" title="Twitter/X">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 24.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      )}
      {SITE_CONFIG.socials.linkedin && (
        <a href={SITE_CONFIG.socials.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 hover:text-blue-400 hover:bg-cyber-card rounded-lg transition-colors" title="LinkedIn">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
      )}
      <a href="/rss.xml" class="p-2 hover:text-amber-400 hover:bg-cyber-card rounded-lg transition-colors" title="RSS Feed">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
      </a>
      <ThemeToggle />
    </div>
    <div class="mt-4 text-center text-xs text-cyber-muted font-mono">
      © {new Date().getFullYear()} {SITE_CONFIG.author}
    </div>
  </div>
</aside>

<!-- Mobile Navigation Drawer & Backdrop -->
<div id="mobile-drawer-backdrop" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-40 hidden transition-opacity lg:hidden"></div>

<aside id="mobile-sidebar-drawer" class="fixed inset-y-0 left-0 w-72 bg-cyber-sidebar border-r border-cyber-border z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between p-6 lg:hidden shadow-2xl">
  <div class="overflow-y-auto">
    <!-- Close Button Header -->
    <div class="flex items-center justify-between pb-4 border-b border-cyber-border/60 mb-4">
      <span class="text-xs font-mono font-bold text-cyber-accent uppercase tracking-wider">Navigation Menu</span>
      <button id="close-drawer-btn" class="p-1.5 text-cyber-muted hover:text-white bg-cyber-card rounded-lg border border-cyber-border" aria-label="Close menu">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Profile Section -->
    <div class="flex flex-col items-center text-center pb-6 border-b border-cyber-border/60">
      <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-cyber-accent/60 mb-3 shadow-[0_0_15px_rgba(0,220,130,0.25)]">
        <img src={SITE_CONFIG.avatar} alt={SITE_CONFIG.author} class="w-full h-full object-cover" />
      </div>
      <h2 class="text-base font-bold tracking-tight text-white font-sans whitespace-nowrap">{SITE_CONFIG.author}</h2>
      <span class="text-xs font-mono text-cyber-accent font-semibold px-2.5 py-0.5 rounded-md bg-cyber-accent/10 border border-cyber-accent/30 inline-block mt-1 mb-2">
        @{SITE_CONFIG.handle}
      </span>
      <p class="text-[11px] text-cyber-muted italic leading-relaxed px-1">{SITE_CONFIG.tagline}</p>
    </div>

    <!-- Mobile Drawer Search Button -->
    <div class="mt-4">
      <button
        data-open-search
        class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg bg-cyber-card border border-cyber-border text-xs text-cyber-muted hover:text-white transition-all shadow-sm cursor-pointer"
      >
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-cyber-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span data-i18n="searchPlaceholder">Search posts, CVEs, tools...</span>
        </div>
        <kbd class="bg-cyber-bg px-1.5 py-0.5 rounded border border-cyber-border/80 font-mono text-[10px] text-cyber-accent">Ctrl+K</kbd>
      </button>
    </div>

    <!-- Mobile Nav Links -->
    <nav class="mt-5 space-y-1.5">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-semibold tracking-wider transition-all duration-200 ${
            isActive(item.href)
              ? 'bg-cyber-accent/10 text-cyber-accent border-l-4 border-cyber-accent font-bold'
              : 'text-cyber-muted hover:text-white hover:bg-cyber-card'
          }`}
        >
          {item.icon === 'home' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          )}
          {item.icon === 'categories' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          )}
          {item.icon === 'server' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
          )}
          {item.icon === 'archive' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          )}
          {item.icon === 'terminal' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          )}
          {item.icon === 'user' && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          )}
          <span data-i18n={item.i18nKey}>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="pt-4 border-t border-cyber-border/60 flex items-center justify-between text-xs font-mono text-cyber-muted">
    <span>© {new Date().getFullYear()} {SITE_CONFIG.author}</span>
    <ThemeToggle />
  </div>
</aside>

<script>
  function setupMobileDrawer() {
    const drawer = document.getElementById('mobile-sidebar-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');

    function openDrawer() {
      drawer?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Global Click Delegation for Mobile Drawer
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('#open-drawer-btn') || target.closest('[data-open-drawer]')) {
        e.preventDefault();
        openDrawer();
        return;
      }
      if (target.closest('#close-drawer-btn') || target.closest('#mobile-drawer-backdrop')) {
        e.preventDefault();
        closeDrawer();
        return;
      }
      // If clicking on any link inside the mobile drawer, close it
      if (target.closest('#mobile-sidebar-drawer a')) {
        closeDrawer();
      }
    });

    // Close on ESC key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDrawer();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileDrawer);
  } else {
    setupMobileDrawer();
  }
</script>
