---
interface Props {
  title: string;
  description?: string;
  pubDate: string;
  categories?: string[];
  tags?: string[];
  pin?: boolean;
  url: string;
  image?: string;
  severity?: string;
  bounty?: string;
}

const { title, description, pubDate, categories = [], tags = [], pin = false, url, image, severity, bounty } = Astro.props;

const getCategoryColor = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('hackthebox') || c.includes('htb')) return 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30';
  if (c.includes('tryhackme') || c.includes('thm')) return 'bg-red-500/10 text-red-400 border-red-500/30';
  if (c.includes('bounty') || c.includes('bug')) return 'bg-amber-500/10 text-amber-400 border-amber-500/30';
  if (c.includes('cve') || c.includes('research')) return 'bg-purple-500/10 text-purple-400 border-purple-500/30';
  return 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30';
};
---

<article class="relative bg-[#1e1e1e] border border-[#2c2d2d] hover:border-[#424242] rounded-xl overflow-hidden transition-all duration-300 hover:shadow-[0_6px_18px_rgba(0,0,0,0.45)] hover:-translate-y-0.5 group">
  <!-- Pinned Ribbon if Pinned -->
  {pin && (
    <div class="absolute top-3 right-3 z-10 bg-cyber-accent text-black text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded shadow flex items-center gap-1">
      <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>
      PINNED
    </div>
  )}

  <!-- Post Preview Image Banner (if available) -->
  {image && (
    <a href={url} class="block overflow-hidden aspect-[16/9] sm:aspect-[2/1] max-h-60 sm:max-h-72 border-b border-[#2c2d2d] bg-[#141416]">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </a>
  )}

  <div class="p-5 sm:p-6">
    <!-- Metadata Bar -->
    <div class="flex flex-wrap items-center gap-2 mb-3 text-xs font-mono text-[#868686]">
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-[#868686]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        {pubDate}
      </span>

      {categories.length > 0 && (
        <>
          <span>•</span>
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#868686]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
            {categories.map((cat) => (
              <a
                href={`/categories/${cat.toLowerCase()}`}
                class={`px-2 py-0.5 rounded border text-[11px] font-medium tracking-wide uppercase transition-colors ${getCategoryColor(cat)}`}
              >
                {cat}
              </a>
            ))}
          </div>
        </>
      )}

      {bounty && (
        <span class="ml-auto text-amber-400 font-bold bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/30 text-[11px]">
          💰 {bounty}
        </span>
      )}
    </div>

    <!-- Title -->
    <h2 class="text-lg sm:text-xl font-bold text-white group-hover:text-cyber-accent transition-colors leading-snug mb-2.5 font-sans">
      <a href={url} class="block focus:outline-none">
        {title}
      </a>
    </h2>

    <!-- Description / Excerpt -->
    {description && (
      <p class="text-sm text-[#afb0b1] line-clamp-2 leading-relaxed mb-4">
        {description}
      </p>
    )}

    <!-- Tags Footer -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-3 border-t border-[#2c2d2d]/60">
        {tags.map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="text-xs font-mono text-[#868686] hover:text-cyber-cyan bg-[#141416] hover:bg-[#252528] px-2 py-0.5 rounded border border-[#2c2d2d] transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
