---
// CyberBootLoader.astro - Mr. Robot / Elite Offensive Security Page Bootloader
const asciiBanner = ` __  __       ____   ___  ___  _____ 
|  \\/  |_ __ |  _ \\ / _ \\/ _ \\|___  |
| |\\/| | '__|| |_) | | | | (_) | / / 
| |  | | |   |  _ <| |_| |\\__, |/ /  
|_|  |_|_|   |_| \\_\\\\___/   /_//_/   
[ MRR0807 OFFENSIVE SECURITY KERNEL v2.4 ]`;
---

<div id="cyber-bootloader" class="fixed inset-0 z-50 bg-[#0a0a0c] text-[#00dc82] font-mono flex flex-col items-center justify-center p-4 sm:p-8 select-none transition-opacity duration-500">
  <!-- Scanline Overlay -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[length:100%_4px] opacity-60 z-10"></div>
  
  <!-- Subtle Vignette / CRT Radial Glow -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_40%,rgba(0,0,0,0.8)_100%)] z-10"></div>

  <!-- Terminal Window Container -->
  <div class="relative z-20 w-full max-w-2xl bg-[#0f1013]/90 border border-[#2c2d2d] rounded-xl shadow-[0_0_50px_rgba(0,220,130,0.15)] overflow-hidden flex flex-col">
    <!-- Window Header -->
    <div class="flex items-center justify-between px-4 py-2.5 bg-[#141416] border-b border-[#2c2d2d] text-xs">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block shadow-[0_0_6px_#ff5f56]"></span>
        <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block shadow-[0_0_6px_#ffbd2e]"></span>
        <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block shadow-[0_0_6px_#27c93f]"></span>
        <span class="ml-2 text-[#868686] text-[11px] font-mono">root@MrR0807-core: ~ (tty1)</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-cyber-accent animate-ping"></span>
        <span class="text-cyber-accent text-[10px] uppercase font-bold tracking-wider">KERNEL ONLINE</span>
      </div>
    </div>

    <!-- Terminal Body -->
    <div class="p-4 sm:p-6 text-xs sm:text-sm font-mono space-y-2.5 min-h-[280px] sm:min-h-[320px] flex flex-col justify-between">
      <!-- ASCII Logo Banner -->
      <pre class="text-[9px] sm:text-xs leading-none text-[#00dc82] font-mono select-none overflow-x-hidden opacity-90">{asciiBanner}</pre>

      <!-- Dynamic Boot Log Lines -->
      <div id="boot-log-container" class="space-y-1.5 text-xs text-[#afb0b1] my-2 font-mono flex-1">
        <!-- Lines injected dynamically by script -->
      </div>

      <!-- Boot Progress Bar -->
      <div class="pt-3 border-t border-[#2c2d2d]/60">
        <div class="flex items-center justify-between text-[11px] font-mono text-[#868686] mb-1.5">
          <span id="boot-status-label" class="text-cyber-accent">INITIALIZING SECURITY SUBSYSTEMS...</span>
          <span id="boot-percent" class="text-white font-bold">0%</span>
        </div>
        <div class="w-full bg-[#1e1e1e] rounded-full h-2 overflow-hidden border border-[#2c2d2d] relative">
          <div id="boot-progress-bar" class="h-full bg-gradient-to-r from-cyber-cyan via-cyber-accent to-[#00f290] transition-all duration-75 w-0 rounded-full shadow-[0_0_10px_rgba(0,220,130,0.8)]"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Skip Hint -->
  <div class="relative z-20 mt-4 text-[11px] font-mono text-[#868686] flex items-center gap-2 cursor-pointer hover:text-cyber-accent transition-colors" id="skip-boot-btn">
    <kbd class="px-2 py-0.5 bg-[#1e1e1e] border border-[#2c2d2d] rounded text-[10px] text-cyber-accent">CLICK</kbd>
    <span>or press any key to bypass intro</span>
  </div>
</div>

<script is:inline>
  (function initCyberBootloader() {
    const loader = document.getElementById('cyber-bootloader');
    if (!loader) return;

    // Check if this navigation is a browser page reload/refresh
    let isReload = false;
    try {
      const navEntry = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
      if (navEntry && navEntry.type === 'reload') {
        isReload = true;
      } else if (window.performance && window.performance.navigation && window.performance.navigation.type === 1) {
        isReload = true;
      }
    } catch (e) {}

    // Check if this is the first visit in the current browser tab session
    const hasVisited = sessionStorage.getItem('mrr0807_session_booted');

    // If already visited and NOT a page reload (i.e. user simply clicked a link/page), bypass immediately
    if (hasVisited && !isReload) {
      loader.style.display = 'none';
      if (loader.parentNode) {
        loader.parentNode.removeChild(loader);
      }
      return;
    }

    // Mark current session as booted
    sessionStorage.setItem('mrr0807_session_booted', 'true');

    const logContainer = document.getElementById('boot-log-container');
    const progressBar = document.getElementById('boot-progress-bar');
    const percentLabel = document.getElementById('boot-percent');
    const statusLabel = document.getElementById('boot-status-label');
    const skipBtn = document.getElementById('skip-boot-btn');

    // 5-Second Authentic Mr. Robot / Offensive Security Sequence
    const bootSteps = [
      { text: '<span class="text-cyber-cyan">[ 0.12s ]</span> <span class="text-white">INITIALIZING KERNEL:</span> Linux 6.6.9-kali1-amd64 x86_64...', delay: 200, pct: 10, status: 'BOOTING KERNEL...' },
      { text: '<span class="text-cyber-cyan">[ 0.65s ]</span> <span class="text-white">PROBING INTERFACES:</span> eth0 (10.10.14.8/24), tun0 <span class="text-cyber-accent font-bold">[TUNNEL ESTABLISHED]</span>', delay: 650, pct: 22, status: 'ESTABLISHING ENCRYPTED TUNNEL...' },
      { text: '<span class="text-cyber-cyan">[ 1.20s ]</span> <span class="text-white">EVADING DEFENSES:</span> Unhooking NTDLL.dll & patching AMSI memory buffer... <span class="text-cyber-accent font-bold">[BYPASSED]</span>', delay: 1200, pct: 36, status: 'BYPASSING DEFENDER & AMSI...' },
      { text: '<span class="text-cyber-cyan">[ 1.80s ]</span> <span class="text-white">QUERYING ACTIVE DIRECTORY:</span> PyScan-AD auditing LDAP, ADCS & Kerberos KDC... <span class="text-cyber-accent font-bold">[OK]</span>', delay: 1800, pct: 50, status: 'AUDITING ACTIVE DIRECTORY...' },
      { text: '<span class="text-cyber-cyan">[ 2.45s ]</span> <span class="text-white">KERBEROASTING:</span> Requesting TGS SPN tickets & cracking hashes via Hashcat... <span class="text-cyber-accent font-bold">[CRACKED]</span>', delay: 2450, pct: 64, status: 'CRACKING SERVICE HASHES...' },
      { text: '<span class="text-cyber-cyan">[ 3.10s ]</span> <span class="text-white">WEB APP EXPLOITS:</span> Probing GraphQL race conditions & AWS IMDS SSRF vectors... <span class="text-cyber-accent font-bold">[EXPLOITED]</span>', delay: 3100, pct: 78, status: 'ANALYZING CLOUD & SSRF VECTORS...' },
      { text: '<span class="text-cyber-cyan">[ 3.75s ]</span> <span class="text-white">PRIVILEGE ESCALATION:</span> Injecting payload via AlwaysInstallElevated & SUID binaries... <span class="text-cyber-accent font-bold">[SYSTEM]</span>', delay: 3750, pct: 88, status: 'ELEVATING PRIVILEGES TO ROOT...' },
      { text: '<span class="text-cyber-cyan">[ 4.30s ]</span> <span class="text-white">DECRYPTING ARCHIVE:</span> Loading 40+ CVE Proof-of-Concepts, Cheatsheets & Bounties... <span class="text-cyber-accent font-bold">[READY]</span>', delay: 4300, pct: 96, status: 'DECRYPTING PORTFOLIO ARCHIVES...' },
      { text: '<span class="text-cyber-cyan">[ 4.80s ]</span> <span class="text-[#00dc82] font-bold">root@MrR0807:~# uid=0(root) gid=0(root) groups=0(root) ACCESS GRANTED.</span>', delay: 4800, pct: 100, status: 'ACCESS GRANTED: WELCOME, OPERATOR MRR0807' }
    ];

    let dismissed = false;

    function dismissLoader() {
      if (dismissed) return;
      dismissed = true;
      loader.style.opacity = '0';
      loader.style.pointerEvents = 'none';
      setTimeout(() => {
        if (loader.parentNode) {
          loader.parentNode.removeChild(loader);
        }
      }, 500);
    }

    // Skip on click or keypress
    if (skipBtn) skipBtn.addEventListener('click', dismissLoader);
    loader.addEventListener('click', dismissLoader);
    window.addEventListener('keydown', dismissLoader, { once: true });

    // Step-by-step terminal execution sequence (Full 5 seconds)
    bootSteps.forEach((step, idx) => {
      setTimeout(() => {
        if (dismissed) return;

        if (logContainer) {
          const p = document.createElement('p');
          p.className = 'leading-relaxed text-[11px] sm:text-xs animate-fade-in font-mono';
          p.innerHTML = step.text;
          logContainer.appendChild(p);
          // Auto scroll to bottom
          logContainer.scrollTop = logContainer.scrollHeight;
        }

        if (progressBar) progressBar.style.width = step.pct + '%';
        if (percentLabel) percentLabel.textContent = step.pct + '%';
        if (statusLabel) {
          statusLabel.textContent = step.status;
          if (idx === bootSteps.length - 1) {
            statusLabel.classList.add('text-[#00dc82]', 'font-bold');
          }
        }

        // Finish at 5.0 seconds
        if (idx === bootSteps.length - 1) {
          setTimeout(dismissLoader, 450);
        }
      }, step.delay);
    });
  })();
</script>
